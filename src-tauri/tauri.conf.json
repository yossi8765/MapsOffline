{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MapsOffline",
  "version": "1.4.0",
  "identifier": "il.mapsoffline.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "MapsOffline",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "center": true,
        "maximized": true,
        "decorations": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "languages": ["Hebrew", "English"],
        "customLanguageFiles": { "Hebrew": "./nsis/Hebrew.nsh" },
        "installerHooks": "./nsis/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    }
  }
}
