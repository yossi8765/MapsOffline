{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MapsOffline",
  "version": "2.0.6",
  "identifier": "il.mapsoffline.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "מפות אופליין",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "center": true,
        "maximized": true,
        "decorations": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: http://mo-sat.localhost http://mo-map.localhost http://mo-user.localhost https://s3.amazonaws.com https://tile.waymarkedtrails.org",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost http://mo-map.localhost http://mo-sat.localhost http://mo-tiles.localhost http://mo-user.localhost https://s3.amazonaws.com https://tile.waymarkedtrails.org data: blob:",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["mapsoffline", "geo"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "languages": ["Hebrew", "English"],
        "customLanguageFiles": { "Hebrew": "./nsis/Hebrew.nsh" },
        "installerHooks": "./nsis/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "recommends": ["geoclue-2.0", "espeak-ng"]
      }
    }
  }
}
